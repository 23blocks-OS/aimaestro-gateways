# Lark Developer Console → App credentials (required for live events)
LARK_APP_ID=
LARK_APP_SECRET=
LARK_DOMAIN=lark
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=

# AMP bridge identity (set AMP_API_KEY after registering the bridge agent,
# or set AMP_AUTO_REGISTER=true to register it at startup)
AMP_AGENT_NAME=lark-bot
AMP_AGENT_ADDRESS=lark-bot@example.aimaestro.local
AMP_API_KEY=
AMP_AUTO_REGISTER=false
AMP_MAESTRO_URL=http://127.0.0.1:23000
AMP_TENANT=example
AMP_DEFAULT_AGENT=default-agent
# In Docker, this directory is mounted from ~/.agent-messaging
AMP_INBOX_DIR=/home/gateway/.agent-messaging/agents/lark-bot/messages/inbox

LARK_ROUTING_FILE=./routing.yaml
STATE_DIR=./data
PORT=3025
BIND_ADDRESS=127.0.0.1
ADMIN_TOKEN=replace-with-a-long-random-token
POLL_INTERVAL_MS=3000
POLL_TIMEOUT_MS=15000
WORKING_DELAY_MS=30000
