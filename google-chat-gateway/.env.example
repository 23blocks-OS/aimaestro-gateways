# --- One shared Chat app (messages routed by @AIM:agent tag) -----------------
GCHAT_PROJECT_ID=my-chat-project
GCHAT_SUBSCRIPTION_ID=aimaestro-chat-sub
# Service account key with Pub/Sub Subscriber on the subscription (also used to call the Chat API)
GOOGLE_APPLICATION_CREDENTIALS=/home/me/.config/aimaestro/gchat-sa.json
# Messages without a tag go here (required unless every bot has a dedicated agent)
AMP_DEFAULT_AGENT=my-agent

# --- OR: several Chat apps, one per agent identity ---------------------------
# GCHAT_BOTS_FILE=./bots.json        (see bots.example.json; replaces the three lines above)

# Gateway
PORT=3024
# ADMIN_TOKEN=change-me               (Bearer token for /api; without it /api is open on 127.0.0.1)

# Full trust, no content wrapping: comma-separated Chat user ids or emails
# OPERATOR_GCHAT_USERS=users/123456789,me@company.com

# AI Maestro (the gateway registers itself and writes AMP_API_KEY here on first start)
# AMP_MAESTRO_URL=http://127.0.0.1:23000
# AMP_AGENT_NAME=gchat-bot
# AMP_TENANT=default

# Tuning
# POLL_INTERVAL_MS=3000
# POLL_TIMEOUT_MS=10000
# DEBUG=true
