{
  "name": "@aimaestro/google-chat-gateway",
  "version": "0.1.0",
  "description": "Google Chat gateway for AI Maestro - routes Google Chat messages to AI Maestro agents over Pub/Sub",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^4.9.0",
    "dotenv": "^16.6.0",
    "express": "^4.18.2",
    "google-auth-library": "^9.15.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
